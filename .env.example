# Time and notification settings
TIMEZONE=Europe/Istanbul
REMINDER_DAYS=30,14,7,3,1,0
REPORT_LOOKAHEAD_DAYS=550
EMAIL_LOOKAHEAD_DAYS=90
EMAIL_DAILY=true
PUBLIC_DASHBOARD_URL=https://steam-etkinlik-radari.example.workers.dev/
EMAIL_RECIPIENT_API_URL=https://steam-etkinlik-radari.example.workers.dev/api/automation/email-recipients
# EMAIL_AUTOMATION_SECRET=uzun-rastgele-deger

# Email recipient
EMAIL_TO=ornek@firma.com
# Optional blind copy that is hidden from recipients
EMAIL_BCC=
EMAIL_FROM="Steam Etkinlik Radarı <bot@firma.com>"

# Preferred simple option: Resend API
# RESEND_API_KEY=re_xxxxxxxxx

# SMTP (a Gmail app password can be used)
# Leave the SMTP fields below empty when using Resend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ornek@gmail.com
SMTP_PASS=uygulama-parolasi

# Optional override for the default official Steamworks source
STEAM_CALENDAR_URL=https://partner.steamgames.com/doc/marketing/upcoming_events?l=english
