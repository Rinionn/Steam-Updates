# Zaman ve bildirim ayarları
TIMEZONE=Europe/Istanbul
REMINDER_DAYS=30,14,7,3,1,0
REPORT_LOOKAHEAD_DAYS=550
EMAIL_DAILY=true

# E-posta alıcısı
EMAIL_TO=ornek@firma.com
EMAIL_FROM="Steam Etkinlik Radarı <bot@firma.com>"

# Tercih edilen kolay yöntem: Resend API
# RESEND_API_KEY=re_xxxxxxxxx

# SMTP (Gmail için uygulama parolası kullanılabilir)
# Resend kullanıyorsanız aşağıdaki SMTP alanlarını boş bırakabilirsiniz.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ornek@gmail.com
SMTP_PASS=uygulama-parolasi

# İsteğe bağlı: varsayılan resmî Steamworks kaynağını değiştirmek için
STEAM_CALENDAR_URL=https://partner.steamgames.com/doc/marketing/upcoming_events?l=english
